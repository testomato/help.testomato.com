{
  "name": "help",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "prettier": "prettier --config .prettierrc --write \"**/*.{js,md}\"",
    "prettier:diff": "prettier --config .prettierrc --list-different \"**/*.{js,md}\"",
    "api": "docusaurus gen-api-docs all",
    "api.mocks": "mock-to-openapi api/mocks",
    "api.clean": "docusaurus clean-api-docs all",
    "api.regenerate": "yarn api.clean && yarn api"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "classnames": "^2.5.1",
    "docusaurus-lunr-search": "^3.6.0",
    "docusaurus-plugin-openapi-docs": "5.0.1",
    "docusaurus-theme-openapi-docs": "5.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@ozzyczech/tsconfig": "^2.1.0",
    "mock-to-openapi": "^1.4.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
